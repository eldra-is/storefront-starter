# Organization id or alias, from Studio > General settings. Required.
ELDRA_ORG_ID=
# Gateway origin. Leave empty for production (https://web.eldra.app/api); /api is appended when missing.
BASE_API_URL=
# Hosted checkout origin. Leave empty for production; set it whenever BASE_API_URL is set.
NUXT_PUBLIC_CHECKOUT_URL=
# Inventory location for stock badges. Empty: no badges; the API still enforces stock on add.
NUXT_PUBLIC_DEFAULT_LOCATION_ID=
# Server-only. When set, server-side reads include drafts. Never give it a NUXT_PUBLIC_ prefix.
# Set it only on a private preview deployment: every visitor to that server sees drafts. Drafts show
# on full server-rendered page loads only; client navigation and lazily resolved blocks read published content.
PREVIEW_TOKEN=
# Canonical site URL, and whether search engines may index it.
NUXT_SITE_URL=http://localhost:3000
NUXT_SITE_INDEXABLE=false

# Business login (organizations with the B2B feature). Off unless the client secret and an issuer
# are set. Studio > Settings > Business sales shows the client id and rotates the secret.
# Keycloak's public origin; the issuer is derived as <base>/realms/shop-<organization UUID>.
NUXT_PUBLIC_KEYCLOAK_BASE_URL=
# Or the shop realm's issuer in full; it wins over the derived one.
NUXT_PUBLIC_SHOP_ISSUER=
NUXT_SHOP_CLIENT_ID=storefront
# Server-only. Never give it a NUXT_PUBLIC_ prefix and never commit it.
NUXT_SHOP_CLIENT_SECRET=
# Where sign-in sessions live: redis, or memory (one server, sign-ins lost on restart). Empty means
# memory in development; in production with a client secret set the server refuses to start
# until this is set.
NUXT_SESSION_STORAGE_DRIVER=
# redis only, e.g. redis://:password@host:6379/0. Read at runtime, never baked into the build.
NUXT_SESSION_STORAGE_URL=
