# Organization id or alias, from Studio > General settings. Required.
ELDRA_ORG_ID=
# Gateway origin. Leave empty for production (https://web.eldra.app/api); /api is appended when missing.
BASE_API_URL=
# Hosted checkout origin. Leave empty for production; set it whenever BASE_API_URL is set.
NUXT_PUBLIC_CHECKOUT_URL=
# Inventory location for stock badges. Empty: no badges; the API still enforces stock on add.
NUXT_PUBLIC_DEFAULT_LOCATION_ID=
# Server-only. When set, server-side reads include drafts. Never give it a NUXT_PUBLIC_ prefix.
# Set it only on a private preview deployment: every visitor to that server sees drafts. Drafts show
# on full server-rendered page loads only; client navigation and lazily resolved blocks read published content.
PREVIEW_TOKEN=
# Canonical site URL, and whether search engines may index it.
NUXT_SITE_URL=http://localhost:3000
NUXT_SITE_INDEXABLE=false
